{
    "name": "movies",
    "private": true,
    "type": "module",
    "workspaces": [
        "frontend",
        "backend"
    ],
    "scripts": {
        "frontend": "npm run dev --workspace frontend",
        "backend": "npm run dev --workspace backend",
        "dc:up": "dotenvx run -f .env -f .env.production -- docker compose up",
        "dc:down": "dotenvx run -f .env -f .env.production -- docker compose down",
        "dc:logs": "dotenvx run -f .env -f .env.production -- docker compose logs",
        "dc-dev:up": "dotenvx run -f .env -f .env.dev -- docker compose --file compose.dev.yml up",
        "dc-dev:down": "dotenvx run -f .env -f .env.dev -- docker compose --file compose.dev.yml down",
        "dc-dev:logs": "dotenvx run -f .env -f .env.dev -- docker compose --file compose.dev.yml logs",
        "lint": "eslint frontend/app backend/src",
        "format": "prettier -w frontend/app backend/src eslint.config.ts frontend/react-router.config.ts frontend/vite.config.ts"
    },
    "devDependencies": {
        "@types/morgan": "^1.9.10",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.6.0",
        "jiti": "^2.7.0",
        "prettier": "^3.8.3",
        "typescript-eslint": "^8.60.0"
    },
    "dependencies": {
        "@dotenvx/dotenvx": "^1.71.0"
    }
}
